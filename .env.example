# Copy this file to .env for local host-run dev (uv run uvicorn ...).
# In the kind cluster, these same values are provided via a K8s Secret/ConfigMap instead — see k8s/base/.

# App identity / behavior
LUNA_ENV=local
LUNA_LOG_LEVEL=INFO

# LLM provider (Phase 1+) — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Database (Phase 3+) — LUNA_DB_PASSWORD feeds the local docker-compose.dev.yml
# Postgres container; DATABASE_URL is what the app actually connects with.
# Keep the password consistent between the two, or the app can't authenticate.
LUNA_DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://luna:change-me@localhost:5432/luna
